{
  "name": "magpie-atomcode-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspace @magpie-community/opencode-atomcode-auth",
    "test:bun": "bun test packages/atomcode/test/*.test.mjs",
    "test:coverage:enforce": "npm run test:coverage:enforce --workspace @magpie-community/opencode-atomcode-auth",
    "pack:check": "npm run pack:check --workspace @magpie-community/opencode-atomcode-auth",
    "test:live": "npm run test:live --workspace @magpie-community/opencode-atomcode-auth"
  },
  "engines": {
    "node": ">=20"
  }
}
